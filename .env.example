# FasalSetu — Environment Configuration
# Copy this file to .env to configure external AI services and server settings

# Server Port
PORT=5000

# AI Provider Configuration
# Supported options: "gemini" (recommended), "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model (Defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Note: If no API key is provided, FasalSetu runs using its built-in
# Agricultural AI Agronomic Engine which understands and responds to
# dynamic farming queries across Hindi, English, and Hinglish.

# ==========================================
# Razorpay Payment Gateway Configuration
# ==========================================
# Obtain your API keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# For Test / Sandbox mode, use keys beginning with 'rzp_test_'
# For Live production mode, use keys beginning with 'rzp_live_'
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Razorpay Webhook Secret for real-time status updates
# Configure in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Webhook URL: http://your-domain.com/api/subscription/webhook
RAZORPAY_WEBHOOK_SECRET=
